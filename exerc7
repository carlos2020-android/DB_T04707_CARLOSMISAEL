-- 5. Consultas avançadas com WHERE
-- JOGADORES COM MAIS DE 30 ANOS
SELECT * FROM PLAYER
WHERE AGE > 25;

-- JOGADORES COM SALÁRIO MENOR QUE 100000
SELECT * FROM PLAYER
WHERE SALARY < 100000;

-- TIMES FUNDADOS APÓS 1900
SELECT * FROM TEAM
WHERE FOUNDATION_YEAR > 1900;

-- 
-- JOGADORES COM MAIS DE 25 ANOS
-- E SALÁRIO MAIOR QUE 100000
SELECT * FROM PLAYER
WHERE AGE > 25 AND SALARY > 100000;

-- TIMES FUNDADOS APÓS 1900 EM SÃO PAULO
SELECT * FROM TEAM
WHERE FOUNDATION_YEAR > 1900
AND CITY = 'São Paulo';

-- JOGADORES COM MENOS DE 25 ANOS
-- OU SALÁRIO MENOR QUE 100000
SELECT * FROM PLAYER
WHERE AGE < 25 OR SALARY < 100000;

-- TIMES DE DUAS CIDADES
SELECT * FROM TEAM
WHERE CITY = 'São Paulo'
OR CITY = 'Rio de Janeiro';

-- JOGADORES ENTRE 20 E 30 ANOS
SELECT * FROM PLAYER
WHERE AGE BETWEEN 20 AND 30;

-- TIMES FUNDADOS ENTRE 1950 E 2020
SELECT * FROM TEAM
WHERE FOUNDATION_YEAR BETWEEN 1950 AND 2020;

-- JOGADORES DE DUAS POSIÇÕES
SELECT * FROM PLAYER
WHERE POSITION IN ('Atacante', 'Goleiro');

-- TIMES DE CIDADES ESPECÍFICAS
SELECT * FROM TEAM
WHERE CITY IN ('São Paulo', 'Santos');

-- NOMES COMEÇANDO COM A
SELECT * FROM PLAYER
WHERE NAME LIKE 'A%';

-- NOMES TERMINANDO COM SILVA
SELECT * FROM PLAYER
WHERE NAME LIKE '%Silva';

-- NOMES CONTENDO JUNIOR
SELECT * FROM PLAYER
WHERE NAME LIKE '%Junior%';

-- NOMES COM TRÊS CARACTERES ANTES DE SILVA
SELECT * FROM PLAYER
WHERE NAME LIKE '___Silva';

